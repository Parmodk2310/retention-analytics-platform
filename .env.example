APP_ENV=development
DEBUG=true

SECRET_KEY=change-me-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_USER=retention
POSTGRES_PASSWORD=change-me
POSTGRES_DB=retention

DATABASE_URL=postgresql+asyncpg://retention:change-me@localhost:55432/retention
DATABASE_URL_SYNC=postgresql+psycopg://retention:change-me@localhost:55432/retention

REDIS_URL=redis://localhost:6379/0

ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080"]
TRUSTED_HOSTS=["localhost","127.0.0.1","backend"]

VITE_API_BASE_URL=/api/v1

GENERATOR_USERS=50000
TARGET_EVENTS=1200000
GENERATOR_SEED=42
GENERATOR_END_DATE=2026-09-07
GENERATOR_ACTIVITY_SCALE=0.076
RESET_ANALYTICS_DATA=false

EVENT_STREAM_NAME=events:ingest
EVENT_STREAM_MAXLEN=100000
EVENT_STREAM_SCHEMA_VERSION=1
EVENT_STREAM_GROUP=retention-event-workers
EVENT_STREAM_BLOCK_MS=5000
EVENT_STREAM_READ_COUNT=100
EVENT_STREAM_DLQ_NAME=events:ingest:dlq
EVENT_STREAM_DLQ_MAXLEN=10000
EVENT_STREAM_RETRY_IDLE_MS=15000
EVENT_STREAM_MAX_DELIVERIES=5
EVENT_DB_BATCH_SIZE=100