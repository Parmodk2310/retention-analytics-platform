APP_NAME=Retention Analytics API
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql+asyncpg://retention:retention@postgres:5432/retention
DATABASE_URL_SYNC=postgresql+psycopg://retention:retention@postgres:5432/retention
REDIS_URL=redis://redis:6379/0
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080"]
TRUSTED_HOSTS=["localhost","127.0.0.1","backend"]
MODEL_ARTIFACT_DIR=/app/app/ml/artifacts
MODEL_ARTIFACT_BUCKET=
SENTRY_DSN=
EVENT_INGEST_KEY=change-me-for-production-event-ingestion
VITE_API_BASE_URL=/api/v1
GENERATOR_USERS=50000
TARGET_EVENTS=1200000
GENERATOR_SEED=42
