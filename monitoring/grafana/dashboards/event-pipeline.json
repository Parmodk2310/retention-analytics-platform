{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "Stream Backlog",
      "targets": [
        {
          "expr": "retention_event_pipeline_backlog",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "Pending",
      "targets": [
        {
          "expr": "retention_event_pipeline_pending",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}
    },
    {
      "type": "stat",
      "title": "Consumer Lag",
      "targets": [
        {
          "expr": "retention_event_pipeline_lag",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}
    },
    {
      "type": "stat",
      "title": "Freshness",
      "targets": [
        {
          "expr": "retention_event_pipeline_freshness_seconds",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Persistence Throughput",
      "targets": [
        {
          "expr": "rate(retention_event_pipeline_persisted_total[1m])",
          "legendFormat": "events/sec",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}
    },
    {
      "type": "timeseries",
      "title": "Persistence p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(retention_event_pipeline_persist_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}
    },
    {
      "type": "timeseries",
      "title": "Duplicates / DLQ",
      "targets": [
        {
          "expr": "rate(retention_event_pipeline_duplicates_total[5m])",
          "legendFormat": "duplicates",
          "refId": "A"
        },
        {
          "expr": "rate(retention_event_pipeline_dead_letter_total[5m])",
          "legendFormat": "DLQ",
          "refId": "B"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13}
    },
    {
      "type": "timeseries",
      "title": "Backpressure Rejections",
      "targets": [
        {
          "expr": "rate(retention_event_pipeline_backpressure_total[5m])",
          "legendFormat": "rejections/sec",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13}
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["retentionos", "events", "redis-streams"],
  "templating": {"list": []},
  "time": {
    "from": "now-1h",
    "to": "now"
  },
