APP_ENV=production
DEBUG=false

# Generate using: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_64_CHARACTER_RANDOM_HEX
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_USER=retention
# Generate using: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=retention

# Replace with the hostname selected after the VM receives its public IP.
PUBLIC_HOST=REPLACE_WITH_HOSTNAME
ACME_EMAIL=REPLACE_WITH_EMAIL
ALLOWED_ORIGINS=["https://REPLACE_WITH_HOSTNAME"]
TRUSTED_HOSTS=["REPLACE_WITH_HOSTNAME","backend","localhost","127.0.0.1"]

VITE_API_BASE_URL=/api/v1

GENERATOR_USERS=10000
TARGET_EVENTS=250000
GENERATOR_SEED=42
GENERATOR_END_DATE=2026-09-10
GENERATOR_ACTIVITY_SCALE=0.076
RESET_ANALYTICS_DATA=false

EVENT_STREAM_NAME=events:ingest
EVENT_STREAM_SCHEMA_VERSION=1
EVENT_STREAM_GROUP=retention-event-workers
EVENT_STREAM_BLOCK_MS=5000
EVENT_STREAM_READ_COUNT=100
EVENT_STREAM_RETRY_IDLE_MS=30000
EVENT_STREAM_MAX_DELIVERIES=5
EVENT_STREAM_DLQ_NAME=events:ingest:dlq
EVENT_STREAM_DLQ_MAXLEN=10000
EVENT_DB_BATCH_SIZE=100
EVENT_PIPELINE_FRESHNESS_KEY=events:pipeline:freshness
EVENT_PIPELINE_FRESHNESS_SLA_SECONDS=60
EVENT_STREAM_BACKLOG_LIMIT=50000
EVENT_STREAM_RETRY_AFTER_SECONDS=5
EVENT_WORKER_METRICS_PORT=9101
