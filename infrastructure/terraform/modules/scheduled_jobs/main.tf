resource "aws_iam_role" "events" { name="${var.name}-events";assume_role_policy=jsonencode({Version="2012-10-17",Statement=[{Effect="Allow",Principal={Service="events.amazonaws.com"},Action="sts:AssumeRole"}]}) }
resource "aws_iam_role_policy" "events" { role=aws_iam_role.events.id;policy=jsonencode({Version="2012-10-17",Statement=[{Effect="Allow",Action=["ecs:RunTask"],Resource=var.task_definition_arn},{Effect="Allow",Action="iam:PassRole",Resource=[var.execution_role_arn,var.task_role_arn]}]}) }
locals { jobs={daily_score={schedule="cron(15 1 * * ? *)",command=["python","-m","app.jobs.score_churn"]},weekly_train={schedule="cron(30 1 ? * SUN *)",command=["python","-m","app.ml.train"]},hourly_analyze={schedule="rate(1 hour)",command=["python","-m","app.jobs.refresh_aggregates"]}} }
resource "aws_cloudwatch_event_rule" "job" { for_each=local.jobs;name="${var.name}-${each.key}";schedule_expression=each.value.schedule }
resource "aws_cloudwatch_event_target" "job" { for_each=local.jobs;rule=aws_cloudwatch_event_rule.job[each.key].name;arn=var.cluster_arn;role_arn=aws_iam_role.events.arn;task_definition_arn=var.task_definition_arn;launch_type="FARGATE";network_configuration { subnets=var.subnet_ids;security_groups=[var.security_group_id];assign_public_ip=true } input=jsonencode({containerOverrides=[{name="backend",command=each.value.command}]}) }
