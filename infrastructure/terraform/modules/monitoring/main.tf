resource "aws_sns_topic" "alerts" { name="${var.name}-alerts" }
resource "aws_cloudwatch_metric_alarm" "cpu" { alarm_name="${var.name}-ecs-high-cpu";comparison_operator="GreaterThanThreshold";evaluation_periods=2;metric_name="CPUUtilization";namespace="AWS/ECS";period=300;statistic="Average";threshold=80;alarm_actions=[aws_sns_topic.alerts.arn];dimensions={ClusterName=var.cluster_name,ServiceName=var.service_name} }
